# CitySoul - Environment Configuration Example

# Qloo Cultural Intelligence API
# Get your API key from the Qloo Developer Portal or Hackathon platform
QLOO_API_KEY=
QLOO_API_BASE_URL=https://hackathon.api.qloo.com/v2

# Optional LLM Provider Key (OpenAI, Anthropic, or Gemini)
# If empty, CitySoul's internal Cultural Intelligence Agent Engine generates
# deterministic, nuanced cultural reasoning based on Qloo taste graph signals.
LLM_API_KEY=
LLM_PROVIDER=openai # openai | gemini | anthropic | mock

# Database
DATABASE_URL=sqlite:///./citysoul.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
