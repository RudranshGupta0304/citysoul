# CitySoul - Environment Configuration Example
# Copy this file to .env and insert your API keys

# Qloo Cultural Intelligence API
# Get your API key from the Qloo Developer Portal or Hackathon platform
QLOO_API_KEY=your_qloo_api_key_here
QLOO_API_BASE_URL=https://hackathon.api.qloo.com/v2

# Optional LLM Provider Key (Google Gemini, OpenAI, or Anthropic)
# Used for conversational reasoning, adaptive follow-ups, and natural language explanations
GOOGLE_API_KEY=your_google_api_key_here

LLM_PROVIDER=gemini # gemini | openai | anthropic | mock
GEMINI_MODEL=gemini-flash-lite-latest

# Database
DATABASE_URL=sqlite:///./citysoul.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app,https://*.render.com
